# Paste your real Anthropic API key (https://console.anthropic.com/) to enable
# the plain-English entry point (ask.py). Routing itself needs no key.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Used when a request says "from home" or gives no address.
ROUTEGEN_HOME_ADDRESS=Your Street, Your City

# Parser model (cheap by design). Uncomment to override.
# ROUTEGEN_MODEL=claude-haiku-4-5

# Optional: free key from https://openrouteservice.org enables the second
# routing provider.
# ORS_API_KEY=
